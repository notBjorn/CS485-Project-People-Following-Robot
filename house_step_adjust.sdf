<?xml version="1.0"?>
<sdf version="1.9">
  <!-- House world for ROS 2 Jazzy / Gazebo Harmonic. Self-contained: primitives only.
       Rooms: living (SW), dining (S centre), bedroom (NW), bathroom (N centre), kitchen (SE).
       Kitchen counters 0.85 m high, 0.55 m deep (reachable by TIAGo); fridge 1.8 m.
       House is offset so the world origin (default robot spawn) is open living-room floor. -->
  <world name="house_step_adjust">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="turtlebot4_house">
      <static>true</static>
      <pose>3.6 2.0 0 0 0 0</pose>
      <link name="house">
      <visual name="bed_blanket_visual"><pose>-0.5000 2.6750 0.5150 0 0 0</pose><geometry><box><size>1.6000 1.3500 0.0300</size></box></geometry><material><ambient>0.250 0.350 0.550 1</ambient><diffuse>0.250 0.350 0.550 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      <visual name="bed_frame_visual"><pose>-0.5000 2.9700 0.1500 0 0 0</pose><geometry><box><size>1.6000 1.9400 0.3000</size></box></geometry><material><ambient>0.300 0.180 0.100 1</ambient><diffuse>0.300 0.180 0.100 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      <visual name="bed_headboard_visual"><pose>-0.5000 3.9700 0.5000 0 0 0</pose><geometry><box><size>1.6000 0.0600 1.0000</size></box></geometry><material><ambient>0.300 0.180 0.100 1</ambient><diffuse>0.300 0.180 0.100 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
