    </model>
    <!-- The person, wearing UWB tag 1 on their back (same model as in
         simple_colored_warehouse.sdf). Driven by VelocityControl on /model/human/cmd_vel
         (launch_human_waypoints.sh house, or launch_human_teleop.sh); OdometryPublisher
         reports their true pose on /model/human/odometry. They start in the living room
         at (0, 1), facing north with the tag towards the robot, which spawns 2.2 m behind
         them at (0, -1.2) facing north (demo_uwb_house.sh). -->
    <model name='human'>
      <pose>0.0 1.0 0 0 0 1.5708</pose>
      <!-- Named base_link so the UWB plugin treats the body as the person's own:
           it then shadows the tag (adds loss) when it is between the tag and an anchor. -->
      <link name='base_link'>
        <!-- No gravity: VelocityControl only commands planar motion, so the
             person stays upright and can't fall over when the robot bumps it -->
        <gravity>false</gravity>
        <inertial>
          <pose>0.1 0 0.95 0 0 0</pose>
          <mass>80.0</mass>
          <inertia>
            <ixx>24.88</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>25.73</iyy><iyz>0</iyz>
            <izz>2.48</izz>
          </inertia>
        </inertial>
        <!-- dartsim can't build mesh collisions, so collide as a cylinder
             (lifted 1 cm off the floor so it slides without friction) -->
        <collision name='body'>
          <pose>0 0 0.91 0 0 0</pose>
          <geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry>
        </collision>
        <!-- Mesh from Fuel model OpenRobotics/Standing person (cached in ~/.gz/fuel).
             The mesh faces -y, so yaw 90 deg turns it to face the model's +x. -->
        <visual name='visual'>
          <pose>0 0 0.02 0.04 0 1.5708</pose>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/standing person/3/files/meshes/standing.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
      <!-- UWB tag 1, worn on the back at waist height, so a robot following behind
           has line of sight to it. No collision, so it doesn't change how the person
           moves or what the LiDAR sees. -->
      <link name='uwb_tag_1'>
        <pose>-0.27 0 1.0 0 0 0</pose>
        <gravity>false</gravity>
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia>
        </inertial>
        <visual name='visual'>
          <geometry><box><size>0.03 0.06 0.09</size></box></geometry>
          <material><ambient>0.96 0.55 0.13 1</ambient><diffuse>0.96 0.55 0.13 1</diffuse></material>
        </visual>
      </link>
      <joint name='uwb_tag_1_joint' type='fixed'>
        <parent>base_link</parent>
        <child>uwb_tag_1</child>
      </joint>
      <plugin name="gz::sim::systems::VelocityControl" filename="gz-sim-velocity-control-system" />
      <plugin name="gz::sim::systems::OdometryPublisher" filename="gz-sim-odometry-publisher-system">
        <odom_frame>world</odom_frame>
        <robot_base_frame>human</robot_base_frame>
        <odom_publish_frequency>20</odom_publish_frequency>
      </plugin>
    </model>

  </world>
</sdf>
