<?xml version="1.0"?>
<sdf version="1.9">
  <!-- TurtleBot 4 house world for ROS 2 Jazzy / Gazebo Harmonic. Self-contained: primitives only.
       House interior 10 x 8 m: living (SW), dining (SE), bedroom (NW), bathroom (NE).
       House is offset so the world origin (default robot spawn) is open living-room floor.
       CS485 changes (copy of turtlebot4_house.sdf from main, by MadsHein):
       - Added the UWB plugin and a person wearing UWB tag 1 (the robots carry anchors 1-4),
         as in simple_colored_warehouse.sdf, for demo_uwb_house.sh.
       - Door thresholds removed: TIAGo can't climb them (2.5 cm, 8.5 degree ramps), and
         as modelled they ran along the walking direction, so the person met a bare
         2.5 cm step. The doorways are flat.
       - Collisions renamed <name>_collision: they shared names with their visuals, which
         the SDF checker (gz sdf -k) rejects.
       The whole house is one link made only of boxes, which the UWB plugin checks box by
       box, so walls and furniture block the signal only where they really are. -->
  <world name="turtlebot4_house">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

<!-- UWB ranging (src/uwb_gazebo_plugin, from UWBPX4Sim), "lps_twr" preset: Bitcraze
     Loco Positioning (DWM1000) in two-way ranging mode. Publishes the distance from
     every anchor I to every tag J on /uwb_gz_simulator/distances/aItJ (gz.msgs.Double,
     centimetres) and the true distance on /uwb_gz_simulator/distances_ground_truth/aItJ.
     Tags and anchors are links named uwb_tag_<id> / uwb_anchor_<id>.
     Regenerate with: python3 src/uwb_gazebo_plugin/preset_to_sdf.py lps_twr -->
<plugin filename="libUWBGazeboPlugin.so" name="custom::UWBGazeboSystem">
  <uwb_mode>twr</uwb_mode>
  <topic>/uwb_gz_simulator/distances</topic>
  <ground_truth_topic>/uwb_gz_simulator/distances_ground_truth</ground_truth_topic>
  <tdoa_topic>/uwb_gz_simulator/tdoa</tdoa_topic>
  <tdoa_ground_truth_topic>/uwb_gz_simulator/tdoa_ground_truth</tdoa_ground_truth_topic>
  <update_rate_hz>30.0</update_rate_hz>
  <path_loss_exponent>2.0</path_loss_exponent>
  <max_link_loss_db>37.5</max_link_loss_db>
  <noise_start_loss_db>23.5</noise_start_loss_db>
  <noise_end_loss_db>37.5</noise_end_loss_db>
  <dropout_center_loss_db>35.5</dropout_center_loss_db>
  <dropout_width_db>1.4</dropout_width_db>
  <min_noise_stddev_cm>8.3</min_noise_stddev_cm>
  <max_noise_stddev_cm>50.0</max_noise_stddev_cm>
  <min_dropout_probability>0.02</min_dropout_probability>
  <enable_nlos_dropout>false</enable_nlos_dropout>
  <nlos_endpoint_margin_m>0.02</nlos_endpoint_margin_m>
  <nlos_min_loss_db>3.0</nlos_min_loss_db>
  <body_shadow_max_loss_db>10.0</body_shadow_max_loss_db>
  <enable_material_attenuation>true</enable_material_attenuation>
  <carrier_frequency_ghz>4.0</carrier_frequency_ghz>
  <material_metal_detour_loss_db>20.0</material_metal_detour_loss_db>
  <enable_dielectric_delay>false</enable_dielectric_delay>
  <moving_outlier_probability>0.35</moving_outlier_probability>
  <moving_outlier_mean_cm>14.7</moving_outlier_mean_cm>
  <moving_outlier_min_speed_mps>0.002</moving_outlier_min_speed_mps>
  <power_bias_cm_per_db>0.99</power_bias_cm_per_db>
  <power_bias_ref_loss_db>16.6</power_bias_ref_loss_db>
  <gaussian_noise_mean_cm>0.0</gaussian_noise_mean_cm>
  <apply_pair_bias>true</apply_pair_bias>
  <bias_min_cm>-34.4</bias_min_cm>
  <bias_max_cm>-10.5</bias_max_cm>
</plugin>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="turtlebot4_house">
      <static>true</static>
      <pose>3.6 2.0 0 0 0 0</pose>
      <link name="house">
      <visual name="bed_blanket"><pose>-0.5000 2.6750 0.5150 0 0 0</pose><geometry><box><size>1.6000 1.3500 0.0300</size></box></geometry><material><ambient>0.250 0.350 0.550 1</ambient><diffuse>0.250 0.350 0.550 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      <visual name="bed_frame"><pose>-0.5000 2.9700 0.1500 0 0 0</pose><geometry><box><size>1.6000 1.9400 0.3000</size></box></geometry><material><ambient>0.300 0.180 0.100 1</ambient><diffuse>0.300 0.180 0.100 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
