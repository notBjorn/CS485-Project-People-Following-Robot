<?xml version="1.0" ?>
<!-- TurtleBot 4 house world, exported from Blender (turtlebot_house.blend).
     10 m x 8 m house: living room, kitchen/dining, bedroom and office.
     Imu/Sensors systems are left to the TurtleBot 4 model, as in box_room.sdf. -->
<sdf version="1.8">
  <world name="turtlebot_house">
    <physics name="1ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.45 0.55 0.4 1</ambient>
            <diffuse>0.45 0.55 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="house">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="Bed">
        <pose>3.9000 2.8250 0.2500 0.0000 -0.0000 0.0000</pose>
        <collision name="collision">
          <pose>0.0000 0.0000 0.0000 0 0 0</pose>
          <geometry><box><size>1.8000 2.0500 0.5000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.8000 2.0500 0.5000</size></box></geometry>
          <material>
            <ambient>0.750 0.750 0.850 1</ambient>
            <diffuse>0.750 0.750 0.850 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <link name="Coffee_Table">
        <pose>-3.0000 1.9000 0.2250 0.0000 -0.0000 0.0000</pose>
        <collision name="collision">
          <pose>0.0000 0.0000 0.0000 0 0 0</pose>
          <geometry><box><size>0.8000 0.6000 0.4500</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8000 0.6000 0.4500</size></box></geometry>
          <material>
            <ambient>0.450 0.300 0.180 1</ambient>
            <diffuse>0.450 0.300 0.180 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <link name="Desk">
        <pose>4.2000 -3.5500 0.3750 0.0000 -0.0000 0.0000</pose>
        <collision name="collision">
          <pose>0.0000 0.0000 0.0000 0 0 0</pose>
          <geometry><box><size>1.2000 0.6000 0.7500</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2000 0.6000 0.7500</size></box></geometry>
          <material>
            <ambient>0.450 0.300 0.180 1</ambient>
            <diffuse>0.450 0.300 0.180 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <link name="Dining_Table">
        <pose>-1.4000 -2.2000 0.3750 0.0000 -0.0000 0.0000</pose>
        <collision name="collision">
          <pose>0.0000 0.0000 0.0000 0 0 0</pose>
          <geometry><box><size>1.2000 0.8000 0.7500</size></box></geometry>
        </collision>
