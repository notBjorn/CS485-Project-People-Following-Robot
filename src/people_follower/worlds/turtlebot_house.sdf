        <collision name="collision">
          <pose>0.0000 0.0000 0.0000 0 0 0</pose>
          <geometry><box><size>0.6000 2.5000 0.9000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6000 2.5000 0.9000</size></box></geometry>
          <material>
