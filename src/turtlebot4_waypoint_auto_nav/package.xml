<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turtlebot4_waypoint_auto_nav</name>
  <version>0.0.0</version>
  <description>Automated Nav2 navigation for the TIAGo or TurtleBot 4 (name kept from the TurtleBot 4 version)</description>
  <maintainer email="madalynnleehein@gmail.com">Madalynn Hein</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>turtlebot4_navigation</depend>
  <depend>nav2_simple_commander</depend>
  <depend>irobot_create_msgs</depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
