    (https://github.com/amartinezsilva/UWBPX4Sim, commit b99d92e).
  </description>
  <maintainer email="floatingbowl@gmail.com">Julian Contreras</maintainer>
  <license>MIT</license>
  <author>Andrés Martínez</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_transport_vendor</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
